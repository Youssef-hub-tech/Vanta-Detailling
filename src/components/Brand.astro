---
import { ui } from '../i18n/ui.js';

const { lang, href, variant = 'default' } = Astro.props;
const t = ui[lang];
const gid = `brand-grad-${Math.random().toString(36).slice(2, 7)}`;
---

<a class:list={['brand', `brand--${variant}`]} href={href} aria-label={t.a11y.home}>
  <svg class="brand__mark" viewBox="0 0 34 34" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#e4cd98"></stop>
        <stop offset="0.55" stop-color="#c6a468"></stop>
        <stop offset="1" stop-color="#8e7647"></stop>
      </linearGradient>
    </defs>
    <path
      d="M5 7.5 L17 27.5 L29 7.5"
      fill="none"
      stroke={`url(#${gid})`}
      stroke-width="3.4"
      stroke-linejoin="miter"
      stroke-linecap="butt"></path>
    <path d="M12.2 7.5 L17 15.4 L21.8 7.5" fill="none" stroke="#0a0a0b" stroke-width="1.1"></path>
  </svg>
  <span class="brand__type">
    <span class="brand__word">{t.brand.mark}</span>
    <span class="brand__sub">{t.brand.sub}</span>
  </span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--paper);
    text-decoration: none;
  }
  .brand__mark {
    inline-size: 1.375rem;
    block-size: 1.375rem;
    flex: none;
  }
  .brand__type {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    min-width: 0;
  }
  .brand__word {
    font-family: var(--font-display);
    font-size: 1.2rem;
    letter-spacing: 0.32em;
    line-height: 1;
    padding-inline-end: 0.1em;
  }
  .brand__sub {
    color: var(--muted);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  html[lang='ar'] .brand__sub {
    font-family: var(--font-ar);
    letter-spacing: 0;
    font-size: 0.72rem;
  }
  .brand--footer .brand__mark {
    inline-size: 1.75rem;
    block-size: 1.75rem;
  }
  .brand--footer .brand__word {
    font-size: 1.5rem;
    letter-spacing: 0.34em;
  }
  .brand--footer .brand__type {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }
  @media (max-width: 30rem) {
    .brand__sub {
      display: none;
    }
  }
</style>
