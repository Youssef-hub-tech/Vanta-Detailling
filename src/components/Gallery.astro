---
import SectionHead from './SectionHead.astro';
import PaintArt from './PaintArt.astro';
import { ui } from '../i18n/ui.js';

const { lang } = Astro.props;
const g = ui[lang].gallery;
---

<section class="section gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="shell">
    <SectionHead
      eyebrow={g.eyebrow}
      title={g.title}
      intro={g.intro}
      id="gallery-title"
    />

    <figure class="gallery__figure reveal">
      <div class="compare" data-compare style="--pos:50%" dir="ltr">
        <div class="compare__layer">
          <PaintArt uid="after-panel" variant="after" label={g.after} />
        </div>
        <div class="compare__layer compare__before">
          <PaintArt uid="before-panel" variant="before" label={g.before} />
        </div>

        <span class="compare__tag compare__tag--before">{g.before}</span>
        <span class="compare__tag compare__tag--after">{g.after}</span>

        <span class="compare__handle" aria-hidden="true">
          <span class="compare__knob">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M10 7 5 12l5 5M14 7l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </span>

        <input
          type="range"
          min="0"
          max="100"
          value="50"
          step="0.1"
          aria-label={g.slider}
          data-compare-input
          data-label-before={g.before}
          data-label-after={g.after}
        />
      </div>
      <figcaption class="gallery__caption">{g.note}</figcaption>
    </figure>

    <ul class="gallery__points">
      {g.points.map(([name, desc], i) => (
        <li class="reveal" style={`--i:${i}`}>
          <span class="gallery__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{name}</h3>
          <p>{desc}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .gallery__figure {
    margin: 0;
  }
  .compare {
    position: relative;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: #07080a;
    touch-action: pan-y;
  }
  .compare__layer {
    position: absolute;
    inset: 0;
  }
  .compare__before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
    will-change: clip-path;
  }
  .compare__tag {
    position: absolute;
    inset-block-start: 1rem;
    padding: 0.3rem 0.75rem;
    background: rgba(7, 7, 8, 0.72);
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--soft);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    pointer-events: none;
  }
  html[lang='ar'] .compare__tag {
    letter-spacing: 0;
    font-size: 0.75rem;
  }
  .compare__tag--before {
    inset-inline-start: 1rem;
  }
  .compare__tag--after {
    inset-inline-end: 1rem;
  }
  .compare__handle {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--pos);
    inline-size: 1px;
    background: linear-gradient(180deg, transparent, var(--gold) 18%, var(--gold) 82%, transparent);
    translate: -0.5px 0;
    pointer-events: none;
    z-index: 2;
  }
  .compare__knob {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    translate: -50% -50%;
    border-radius: 50%;
    border: 1px solid var(--gold);
    background: rgba(7, 7, 8, 0.82);
    color: var(--gold-hi);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    box-shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.9);
  }
  .compare__knob svg {
    inline-size: 1.1rem;
    block-size: 1.1rem;
  }
  .compare input {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    z-index: 3;
  }
  .compare:focus-within {
    outline: 2px solid var(--gold-hi);
    outline-offset: 3px;
  }
  .compare:focus-within .compare__knob {
    border-color: var(--gold-hi);
    box-shadow: 0 0 0 4px rgba(198, 164, 104, 0.18);
  }
  .gallery__caption {
    margin-block-start: 0.9rem;
    color: var(--muted);
    font-size: 0.78rem;
    text-align: end;
  }
  .gallery__points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 4vw, 3rem);
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    border-block-start: 1px solid var(--line);
    padding-block-start: clamp(1.5rem, 3vw, 2.25rem);
  }
  .gallery__points li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .gallery__num {
    color: var(--gold);
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }
  .gallery__points h3 {
    font-size: 1.2rem;
  }
  .gallery__points p {
    color: var(--muted);
    font-size: 0.9rem;
    max-width: 34ch;
  }

  @media (max-width: 48rem) {
    .compare {
      aspect-ratio: 4 / 3;
    }
    .compare__knob {
      inline-size: 2.6rem;
      block-size: 2.6rem;
    }
    .gallery__points {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
    .gallery__points li {
      padding-block-end: 1.25rem;
      border-block-end: 1px solid var(--line);
    }
    .gallery__points li:last-child {
      border-block-end: 0;
      padding-block-end: 0;
    }
  }
</style>
