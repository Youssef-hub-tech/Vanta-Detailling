---
import '../styles/global.css';
import { site, ui } from '../i18n/ui.js';

const { lang } = Astro.props;
const t = ui[lang];
const url = site.url + t.path;
const altUrl = site.url + t.altPath;

// Structured data mirrors the visible page. The brand is fictional, so the
// description says so and every contact field is a placeholder.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoDetailing',
  '@id': url + '#business',
  name: 'VANTA Detailing',
  disambiguatingDescription:
    'Fictional car detailing studio created for a portfolio demonstration. All details are placeholders.',
  url,
  telephone: site.phone,
  email: site.email,
  priceRange: 'SAR 350–3,800',
  currenciesAccepted: 'SAR',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Placeholder address',
    addressLocality: 'Riyadh',
    addressRegion: 'Riyadh Province',
    addressCountry: 'SA',
  },
  areaServed: { '@type': 'City', name: 'Riyadh' },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
      opens: '09:00',
      closes: '21:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Friday',
      opens: '16:00',
      closes: '21:00',
    },
  ],
};
---

<!doctype html>
<html lang={lang} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.desc} />
    <meta name="author" content="VANTA Detailing (portfolio demo)" />
    <meta name="theme-color" content="#070708" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={url} />

    <link rel="alternate" hreflang="en" href={site.url + '/'} />
    <link rel="alternate" hreflang="ar" href={site.url + '/ar/'} />
    <link rel="alternate" hreflang="x-default" href={site.url + '/'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VANTA Detailing" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.desc} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'ar_SA' : 'en_SA'} />
    <meta property="og:image" content={site.url + '/og.jpg'} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.desc} />
    <meta name="twitter:image" content={site.url + '/og.jpg'} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    {
      lang === 'en' ? (
        <>
          <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
          <link rel="preload" href="/fonts/instrument-serif-400.woff2" as="font" type="font/woff2" crossorigin />
        </>
      ) : (
        <>
          <link rel="preload" href="/fonts/plex-arabic-400.woff2" as="font" type="font/woff2" crossorigin />
          <link rel="preload" href="/fonts/naskh-arabic-600.woff2" as="font" type="font/woff2" crossorigin />
        </>
      )
    }

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <slot />
    <script src="../scripts/main.js"></script>
  </body>
</html>
